# ---------------------------------------------------------------------------
# Skyborn environment
#
# Phase 1 needs only the variables in the first block. Everything below it is
# declared now so the file matches spec Section 18 — each block notes the phase
# that first reads it. Leave the unused ones blank.
# ---------------------------------------------------------------------------

# --- Phase 1: required to run the app ---------------------------------------
DATABASE_URL="postgresql://skyborn:skyborn@localhost:5432/skyborn?schema=public"

# Session signing for the human-facing auth (Mode A).
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Signs the agent access tokens issued off a Grant (Mode B, from Phase 4).
# Generate with: openssl rand -base64 32
JWT_SECRET=""

# Domain used for handle email addresses. Keep it a non-routable domain until
# Postmark is wired in (Phase 3), so nothing mistakes a handle for a real inbox.
SKYBORN_HANDLE_EMAIL_DOMAIN="agents.skyborn.local"

# --- Clerk (only if Clerk replaces the built-in credentials auth) ------------
# CLERK_SECRET_KEY=""
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# --- Phase 2: sandbox money -------------------------------------------------
RAZORPAY_KEY_ID_TEST=""
RAZORPAY_KEY_SECRET_TEST=""

# --- Phase 3: the handle's email, SMS and voice -----------------------------
POSTMARK_SERVER_TOKEN=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# --- Background jobs (async settlement, delivery, webhook retries) -----------
REDIS_URL="redis://localhost:6379"

# --- Phase 6/7: protocol adapters -------------------------------------------
# Path to the scl-axl CLI; see the AXL repo's own setup docs for the rest.
AXL_CLI_PATH=""
# OAuth configuration for the MCP server. Check the current MCP spec before
# filling this in — the handshake and OAuth requirements changed recently.
MCP_SERVER_OAUTH_CONFIG=""

# --- Phase 9: identity verification -----------------------------------------
# Digio / Signzy / HyperVerge / IDfy (India) or Persona / Trulioo (US).
# Skyborn stores the vendor's verdict and reference only — never a raw
# Aadhaar number or SSN.
KYC_VENDOR_API_KEY=""

# --- Phase 10: live mode ----------------------------------------------------
RAZORPAY_KEY_ID_LIVE=""
RAZORPAY_KEY_SECRET_LIVE=""
RAZORPAYX_ACCOUNT_NUMBER=""
# Razorpay Route / Cashfree / Decentro / M2P / Setu — whichever partner holds
# the nodal/escrow account. Skyborn never self-issues a wallet.
CUSTODY_PARTNER_API_KEY=""

# --- Phase 3: inbound webhook authentication -------------------------------
# Postmark does not sign its requests, so the inbound URL carries this secret
# and every delivery must present it. Generate with: openssl rand -base64 32
POSTMARK_INBOUND_SECRET=""
# The exact public URL Twilio posts to. Its request signature is computed over
# this URL, so it must match what Twilio was configured with, not what the app
# sees behind a proxy.
TWILIO_WEBHOOK_URL=""
